# ==========================================================
# FATURA MAIS — variáveis de ambiente do frontend (Vite)
# Copia para `.env` e ajusta conforme o ambiente.
# ==========================================================
# Raiz única da API. Os pedidos passam pelo proxy:
#   - Docker  -> nginx (porta 80) encaminha /api/v1/auth e /api/v1/users
#                para auth_service e /api/v1/company para organization_service
#   - npm run dev -> server.proxy do Vite (vite.config.ts) encaminha /api
VITE_AUTH_API_URL=/api
VITE_ORGANIZATION_API_URL=/api

# ----------------------------------------------------------
# Alternativa: ligação directa aos serviços publicados (sem proxy).
# Descomenta para desenvolvimento local sem nginx/Docker.
# ----------------------------------------------------------
# VITE_AUTH_API_URL=http://localhost:8001/api
# VITE_ORGANIZATION_API_URL=http://localhost:8002/api

# ---------------------------------------------------------------------------
# Angola Core Data — catálogo central de bancos (GET /api/v1/banks).
#
# É um serviço à parte (docker-compose.yml próprio: `8003:80`), com CORS aberto
# e endpoint PÚBLICO (não precisa de token). Como o nginx/proxy do Vite só
# encaminham auth/organization, o valor aqui é ABSOLUTO.
#
# Ajuste a porta/host se publicar o serviço noutro sítio.
# ---------------------------------------------------------------------------
VITE_CORE_DATA_API_URL=http://localhost:8003/api

# ---------------------------------------------------------------------------
# Proxy de desenvolvimento do Vite (`npm run dev`).
#
# Por omissão (nada definido) cada rota vai DIRECTAMENTE ao serviço publicado no
# host pelo respectivo docker-compose.yml:
#   /api/v1/auth e /api/v1/users            -> http://localhost:8000 (auth_service)
#   /api/v1/company e /api/v1/organizations -> http://localhost:8002 (organization_service)
#
# Defina VITE_DEV_PROXY_TARGET para encaminhar TUDO pelo gateway nginx (:80):
# VITE_DEV_PROXY_TARGET=http://localhost:80
#
# Só é necessário se as portas publicadas no host forem outras:
# VITE_DEV_AUTH_TARGET=http://localhost:8000
# VITE_DEV_ORGANIZATION_TARGET=http://localhost:8002
# ---------------------------------------------------------------------------

# Mostrar o aviso de ambiente de demonstração mesmo em build de produção.
# VITE_SHOW_DEMO_NOTICE=true
